[Unit]
Description=Minecraft Discord bot
After=network-online.target rlcraft-terminal.service
# Wants, not Requires: a Requires dependency that fails once cancels this job
# for the whole boot, even after the terminal recovers on its own.
Wants=network-online.target rlcraft-terminal.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/rlcraft-discord
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rlcraft-discord/venv/bin/python discord_integration.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
