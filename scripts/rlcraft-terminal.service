[Unit]
Description=Minecraft Discord terminal (RCON and logs)
After=network-online.target minecraft-server.service
# Wants, not Requires: ExecStartPre already waits for RCON, and Restart=always
# recovers on its own without a hard dependency cancelling the job.
Wants=network-online.target minecraft-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/rlcraft-discord
Environment=PYTHONUNBUFFERED=1
Environment=LOG_FILE_PATH=/opt/minecraft-booter/current/logs/latest.log
ExecStartPre=/opt/rlcraft-discord/wait-rcon.sh
ExecStart=/opt/rlcraft-discord/venv/bin/python minecraft_terminal.py
Restart=always
RestartSec=10
# BMC6 needs well over 90s to open RCON, which overruns the default start timeout
# and kills wait-rcon.sh mid-wait.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
