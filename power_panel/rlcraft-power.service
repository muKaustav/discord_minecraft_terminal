[Unit]
Description=RLCraft AWS power switch web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/rlcraft-power
EnvironmentFile=/opt/rlcraft-power/.env
ExecStart=/opt/rlcraft-power/venv/bin/waitress-serve --listen=127.0.0.1:8080 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
